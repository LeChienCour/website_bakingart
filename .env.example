# ---------------------------------------------------------------------------
# Sanity — required for both Next.js frontend and Sanity Studio
# ---------------------------------------------------------------------------

# Your Sanity project ID (found at sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset name (usually "production")
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version in YYYY-MM-DD format
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API token with read permissions (server-only — never expose to browser)
# Required for authenticated / draft-mode fetches
SANITY_API_READ_TOKEN=

# Secret used to verify incoming webhook payloads (HMAC-SHA256)
# Generate with: openssl rand -hex 32
SANITY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Next.js
# ---------------------------------------------------------------------------

# Canonical site URL — used for metadataBase and sitemap generation
NEXT_PUBLIC_SITE_URL=https://bakingart-gdl.vercel.app
